# ============ 必改 ============
SECRET_KEY=请换成随机 64 位字符串
ADMIN_USERNAME=admin
ADMIN_PASSWORD=请换成至少10位含三类字符的强密码
# Telethon 会话加密密钥（生成：python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"）
SESSION_ENC_KEY=
POSTGRES_USER=op
POSTGRES_PASSWORD=请换成强密码
POSTGRES_DB=operator

# ============ 模型（OpenAI 兼容，二选一或自建网关）============
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-你的key
LLM_MODEL=gpt-4o-mini
# 抽取/画像用的小模型，可留空
LLM_JSON_MODEL=
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=700
LLM_TIMEOUT=60
LLM_FALLBACK_MODELS=
# 多厂商轮换链（JSON 数组，按顺序尝试，前一家额度用完/限流/下线自动换下一家）
# LLM_PROVIDERS=[{"name":"groq","base_url":"https://api.groq.com/openai/v1","api_key":"gsk_xxx","models":["openai/gpt-oss-120b"],"json_models":["openai/gpt-oss-120b"],"extra":{"reasoning_effort":"low"}}]
LLM_PROVIDERS=

# ============ Telegram 应用凭据（my.telegram.org 申请）============
TG_API_ID=
TG_API_HASH=

# ============ 语音 ============
TTS_PROVIDER=edge
# 克隆音色（ElevenLabs 兼容接口，可选）
TTS_CLONE_BASE_URL=
TTS_CLONE_API_KEY=
# OpenAI TTS（可选）
TTS_OPENAI_BASE_URL=https://api.openai.com/v1
TTS_OPENAI_API_KEY=
TTS_OPENAI_MODEL=tts-1
# Azure 语音（可选，音色更多）
TTS_AZURE_KEY=
TTS_AZURE_REGION=

# ============ 语音识别 ============
ASR_BACKEND=faster-whisper
ASR_MODEL=large-v3
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
# 或者用远程接口
ASR_OPENAI_BASE_URL=
ASR_OPENAI_API_KEY=
ASR_OPENAI_MODEL=whisper-1
# Groq Whisper（推荐：免费额度大、中文准）
ASR_GROQ_API_KEY=
ASR_GROQ_MODEL=whisper-large-v3

# ============ 限速默认值（后台单账号可覆盖）============
RL_MINUTE=6
RL_HOUR=40
RL_DAY=150
WARMUP_QUIET_HOURS=36
WARMUP_WEEK1_DAILY=8

LOG_LEVEL=INFO

# ============ 控制 bot ============
CONTROL_BOT_TOKEN=
# 控制者 Telegram 数字 id（逗号分隔）。设了就固定是你，不会"谁先说谁是主人"
CONTROL_ADMIN_IDS=
